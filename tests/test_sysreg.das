;; ============================================================
;; test_sysreg.das - 系统寄存器 SETB/GETB 往返测试
;; 覆盖: CBASE / CLIMIT / DBASE / DLIMIT / KSP / XAR / ICTB
;;       / RIN3_CTRL 的写入与读回一致性
;;
;; 运行:
;;   sh tests/run_test.sh tests/test_sysreg.das
;;
;; 期望(寄存器转储):
;;   A  = 0x00005A5A (全部8个系统寄存器往返一致; 任一失败则 A=0x00000000)
;; ============================================================

	SECTION TEXT
	ORG 0

START:
	;; ---- 依次写入各系统寄存器 ----
	LET D1, DWORD 0x11111111
	SETB CBASE, D1
	LET D1, DWORD 0x22222222
	SETB CLIMIT, D1
	LET D1, DWORD 0x33333333
	SETB DBASE, D1
	LET D1, DWORD 0x44444444
	SETB DLIMIT, D1
	LET D1, DWORD 0x55555555
	SETB KSP, D1
	LET D1, DWORD 0x66666666
	SETB XAR, D1
	LET D1, DWORD 0x77777777
	SETB ICTB, D1
	LET D1, DWORD 0x00880000	; RIN3_CTRL: GIE=0, ISRB=0x88
	SETB RIN3_CTRL, D1

	;; ---- 逐一读回并断言 ----
	;; CBASE
	GETB D2, CBASE
	LET C, DWORD 0x11111111
	CMP DWORD D2
	LET E, DWORD C_CLIMIT
	JZ
	ZERO A
	HLT
C_CLIMIT:
	GETB D2, CLIMIT
	LET C, DWORD 0x22222222
	CMP DWORD D2
	LET E, DWORD C_DBASE
	JZ
	ZERO A
	HLT
C_DBASE:
	GETB D2, DBASE
	LET C, DWORD 0x33333333
	CMP DWORD D2
	LET E, DWORD C_DLIMIT
	JZ
	ZERO A
	HLT
C_DLIMIT:
	GETB D2, DLIMIT
	LET C, DWORD 0x44444444
	CMP DWORD D2
	LET E, DWORD C_KSP
	JZ
	ZERO A
	HLT
C_KSP:
	GETB D2, KSP
	LET C, DWORD 0x55555555
	CMP DWORD D2
	LET E, DWORD C_XAR
	JZ
	ZERO A
	HLT
C_XAR:
	GETB D2, XAR
	LET C, DWORD 0x66666666
	CMP DWORD D2
	LET E, DWORD C_ICTB
	JZ
	ZERO A
	HLT
C_ICTB:
	GETB D2, ICTB
	LET C, DWORD 0x77777777
	CMP DWORD D2
	LET E, DWORD C_CTRL
	JZ
	ZERO A
	HLT
C_CTRL:
	GETB D2, RIN3_CTRL
	LET C, DWORD 0x00880000
	CMP DWORD D2
	LET E, DWORD PASS
	JZ
	ZERO A
	HLT

PASS:
	LET A, DWORD 0x00005A5A		; 通过标记
	HLT
